# Local gateway defaults to the existing machine's Codex sign-in. Never commit credentials.
GEYOU_AGENT_PORT=5197
GEYOU_AI_PROVIDER=codex
GEYOU_CODEX_BIN=/usr/local/bin/codex
GEYOU_CODEX_BINARY=/usr/local/bin/codex
# Optional API mode: set GEYOU_AI_PROVIDER=api and the key locally.
# GEYOU_AI_API_KEY=
# GEYOU_AI_BASE_URL=https://api.openai.com/v1
# GEYOU_AI_MODEL=gpt-4.1-mini
